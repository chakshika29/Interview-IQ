# Environment variables and API keys (CRITICAL: NEVER COMMIT)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Virtual environment
venv/
.venv/

# Sensitive data directory (Candidate resumes contain personal contact details)
data/

# Private session recordings & session files
storage/recordings/
storage/sessions/

# Frontend dependencies & production build outputs
frontend/node_modules/
frontend/dist/

# Local embedding and document caches
.cache/

# Python bytecode & cache files
__pycache__/
*.py[cod]
*$py.class

# Testing artifacts
.pytest_cache/
.coverage
htmlcov/
