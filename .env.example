# ==============================================================================
# InterviewIQ - Environment Configuration Example
# Copy this file to .env and provide your secret API keys
# ==============================================================================

# Google Gemini API Key (Required for generation, embeddings & speech-to-text)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Primary LLM Model for Interview Questions & Answer Evaluation
# Supported options: gemini-3.5-flash-lite (fastest, highly stable), gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Comma-separated Fallback Model Cascade if primary encounters 503 or transient spike
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-flash-latest

# Dense Semantic Embedding Model (Cosine distance in ChromaDB)
EMBED_MODEL=gemini-embedding-001

# React Frontend -> FastAPI Backend Target URL
VITE_API_URL=http://localhost:8000
